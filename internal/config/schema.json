{
  "$schema": "http://json-schema.org/draft-06/schema#",
  "title": "DVA Configuration Schema",
  "description": "Schema for the dva.yml configuration file",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "environment_vars": {
      "type": "object",
      "description": "Defines environment variables",
      "additionalProperties": {
        "type": ["string", "boolean", "number"]
      },
      "examples": [
        { "RAILS_ENV": "development" },
        { "DATABASE_URL": "postgres://user:password@db:5432/myapp_development" },
        { "PORT": "${PORT:-3000}" }
      ]
    },
    "env_file": {
      "oneOf": [
        {
          "type": "string",
          "description": "Path to a single .env file"
        },
        {
          "type": "array",
          "items": {
            "oneOf": [
              { "type": "string" },
              {
                "type": "object",
                "properties": {
                  "path": { "type": "string" },
                  "required": { "type": "boolean", "default": false }
                },
                "required": ["path"],
                "additionalProperties": false
              }
            ]
          },
          "description": "Array of .env file paths (later files override earlier)"
        },
        {
          "type": "object",
          "properties": {
            "files": {
              "oneOf": [
                { "type": "string" },
                {
                  "type": "array",
                  "items": {
                    "oneOf": [
                      { "type": "string" },
                      {
                        "type": "object",
                        "properties": {
                          "path": { "type": "string" },
                          "required": { "type": "boolean", "default": false }
                        },
                        "required": ["path"],
                        "additionalProperties": false
                      }
                    ]
                  }
                }
              ]
            },
            "priority": {
              "type": "string",
              "enum": ["before_environment", "after_environment"],
              "default": "before_environment",
              "description": "Control whether env_file or environment: takes precedence"
            },
            "required": {
              "type": "boolean",
              "default": false,
              "description": "Whether env files are required to exist"
            },
            "interpolate": {
              "type": "boolean",
              "default": true,
              "description": "Enable variable interpolation in .env files"
            }
          },
          "required": ["files"],
          "additionalProperties": false
        }
      ],
      "examples": [
        ".env",
        [".env.defaults", ".env", ".env.local"],
        {
          "files": [".env.defaults", ".env"],
          "priority": "before_environment",
          "required": false
        }
      ]
    },
    "provision_item": {
      "oneOf": [
        {
          "type": "string",
          "description": "Raw shell command string"
        },
        {
          "type": "object",
          "description": "Step-based command with name, run commands, and optional notes",
          "additionalProperties": false,
          "properties": {
            "step": {
              "type": "string",
              "description": "Name of the step (displayed with progress indicator)"
            },
            "run": {
              "oneOf": [
                { "type": "string" },
                { "type": "array", "items": { "type": "string" } }
              ],
              "description": "Command(s) to execute for this step"
            },
            "note": {
              "type": "string",
              "description": "Informational note displayed before/after commands"
            },
            "compose_up": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Docker Compose services to start (inherits compose config)"
            },
            "compose_exec": {
              "type": "string",
              "description": "Command to execute in a compose service"
            },
            "compose_run": {
              "type": "string",
              "description": "One-off command in a compose service"
            },
            "parallel": {
              "type": "boolean",
              "description": "Run this step concurrently with other consecutive parallel steps",
              "default": false
            }
          },
          "required": ["step"]
        },
        {
          "type": "object",
          "description": "Legacy structured command",
          "additionalProperties": false,
          "properties": {
            "echo": { "type": "string" },
            "cmd": { "type": "string" },
            "shell": { "type": "string" },
            "sleep": {
              "oneOf": [
                { "type": "integer" },
                { "type": "number" },
                { "type": "string" }
              ]
            },
            "docker": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "compose": {
                  "oneOf": [
                    { "type": "string" },
                    { "type": "array", "items": { "type": "string" } }
                  ]
                }
              },
              "required": ["compose"]
            }
          },
          "minProperties": 1,
          "maxProperties": 1
        }
      ]
    },
    "interaction_command": {
      "type": "object",
      "description": "Configuration for an interaction command",
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string",
          "description": "Describes the command",
          "examples": ["Run Rails commands", "Connect to PostgreSQL database"]
        },
        "service": {
          "type": "string",
          "description": "Specifies the service associated with the command",
          "examples": ["web", "frontend", "db"]
        },
        "command": {
          "type": "string",
          "description": "Represents the command to be executed",
          "examples": ["bundle exec rails", "npm", "psql -h db -U user myapp_development"]
        },
        "workdir": {
          "type": "string",
          "description": "Specifies the working directory for the command",
          "examples": ["/workdir", "/app"]
        },
        "user": {
          "type": "string",
          "description": "Specifies the user to run the command as",
          "examples": ["root:root", "root", "www-data", "1000:1000"]
        },
        "default_args": {
          "type": "string",
          "description": "Default arguments for the command",
          "examples": ["server -p 3000 -b 0.0.0.0"]
        },
        "environment": {
          "$ref": "#/definitions/environment_vars"
        },
        "env_file": {
          "$ref": "#/definitions/env_file"
        },
        "compose": {
          "type": "object",
          "description": "Allows specifying Docker Compose options",
          "additionalProperties": false,
          "properties": {
            "method": {
              "type": "string",
              "description": "Specifies the Docker Compose method (e.g., up, run)",
              "examples": ["run", "up", "exec"]
            },
            "compose_method": {
              "type": "string",
              "description": "Specifies an alternative Docker Compose method to use in compose commands",
              "examples": ["up"]
            },
            "run_options": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Options to pass to the 'docker-compose run' command",
              "examples": [["service-ports", "rm"]]
            },
            "profiles": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Docker Compose profiles to use",
              "examples": [["web", "development"], ["frontend"], ["test"]]
            }
          }
        },
        "shell": {
          "type": "boolean",
          "description": "Enables or disables shell interpolation"
        },
        "entrypoint": {
          "type": "string",
          "description": "Specifies the command entrypoint"
        },
        "runner": {
          "type": "string",
          "description": "Specifies the runner (e.g., docker_compose, kubectl)"
        },
        "pod": {
          "type": "string",
          "description": "Specifies the pod for the kubectl runner"
        },
        "compose_run_options": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "DEPRECATED: Options to pass to the 'docker-compose run' command",
          "examples": [["service-ports", "rm"]]
        },
        "subcommands": {
          "type": "object",
          "description": "Contains subcommands with the same structure as main commands",
          "patternProperties": {
            "^[\\w\\-.:/\\s]+$": {
              "$ref": "#/definitions/interaction_command"
            }
          },
          "minProperties": 1,
          "additionalProperties": false
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Tags for categorizing this command (e.g., test, quality, infra)",
          "examples": [["test"], ["quality"], ["infra", "db"]]
        },
        "before": {
          "type": "array",
          "items": { "$ref": "#/definitions/provision_item" },
          "description": "Steps to run before a hookable built-in command (up, down, stop, restart, build, clean, logs)"
        },
        "replace": {
          "type": "array",
          "items": { "$ref": "#/definitions/provision_item" },
          "description": "Steps that replace the built-in command entirely"
        },
        "after": {
          "type": "array",
          "items": { "$ref": "#/definitions/provision_item" },
          "description": "Steps to run after the built-in command completes successfully"
        }
      }
    }
  },
  "properties": {
    "version": {
      "type": "string",
      "description": "Specifies the minimum required version of DVA",
      "examples": ["8.1.0"]
    },
    "stack": {
      "type": "object",
      "description": "Named stack entries defining the infrastructure lifecycle pipeline. Each key is the entry name. When the key matches a known plugin name (e.g., 'compose', 'kubectl'), the plugin type is auto-inferred. Use `plugin:` for custom names (e.g., 'my-db: plugin: compose'). Plugin-specific fields go at the top level (flat format). Entries execute in ascending order of `order` for up, descending for down/stop.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "plugin": {
            "type": "string",
            "description": "Plugin type (flat format). Specifies which plugin to use; plugin-specific fields go at the top level of this entry.",
            "enum": ["compose", "process", "script", "docker", "kubectl", "helm", "kustomize", "tilt", "skaffold", "podman-compose", "podman_compose", "vagrant", "sam", "serverless", "multipass"],
            "examples": ["compose", "kubectl", "helm"]
          },
          "order": {
            "type": "integer",
            "description": "Execution order (ascending for up, descending for down/stop)",
            "examples": [10, 20, 30]
          },
          "tags": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Tags for categorizing this lifecycle entry"
          },
          "exports": {
            "type": "object",
            "description": "Environment variables to export to subsequent lifecycle entries",
            "additionalProperties": { "type": "string" }
          },
          "health_checks": {
            "type": "object",
            "description": "Health checks specific to this lifecycle entry",
            "patternProperties": {
              "^[\\w\\-.]+$": {
                "type": "object",
                "properties": {
                  "type": { "type": "string", "enum": ["http", "tcp", "command"] },
                  "url": { "type": "string" },
                  "address": { "type": "string" },
                  "command": { "type": "string" },
                  "timeout": { "type": "integer" }
                },
                "required": ["type"]
              }
            }
          },
          "compose": {
            "type": "object",
            "description": "Docker Compose plugin configuration",
            "additionalProperties": false,
            "properties": {
              "files": {
                "type": "array",
                "items": { "type": "string" },
                "description": "Paths to Docker Compose files",
                "examples": [["compose.yml", "compose.override.yml"]]
              },
              "project_name": {
                "type": "string",
                "description": "Project name for Docker Compose"
              },
              "command": {
                "type": "string",
                "description": "Alternative Docker Compose command",
                "examples": ["docker compose", "podman compose"]
              },
              "method": {
                "type": "string",
                "description": "Docker Compose method to use"
              },
              "up_options": {
                "type": "array",
                "items": { "type": "string" },
                "description": "Default options for up command",
                "examples": [["-d", "--wait"]]
              },
              "tags": {
                "type": "array",
                "items": { "type": "string" },
                "description": "Default tags for all compose services"
              },
              "services": {
                "type": "object",
                "description": "Per-service configuration",
                "patternProperties": {
                  "^[\\w\\-.]+$": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "tags": {
                        "type": "array",
                        "items": { "type": "string" }
                      },
                      "ports": {
                        "type": "object",
                        "patternProperties": {
                          "^[0-9]+$": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                              "label": { "type": "string" },
                              "http": { "type": "boolean" },
                              "paths": {
                                "type": "object",
                                "additionalProperties": { "type": "string" }
                              }
                            }
                          }
                        },
                        "additionalProperties": false
                      },
                      "related": {
                        "type": "array",
                        "items": { "type": "string" }
                      },
                      "hint": { "type": "string" }
                    }
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "process": {
            "type": "object",
            "description": "Local process plugin configuration",
            "additionalProperties": false,
            "properties": {
              "command": { "type": "string", "description": "Command to run" },
              "dir": { "type": "string", "description": "Working directory" },
              "ready_timeout": { "type": "integer", "description": "Timeout in seconds to wait for readiness" }
            }
          },
          "script": {
            "type": "object",
            "description": "Shell script plugin configuration",
            "additionalProperties": false,
            "properties": {
              "up": { "type": "string", "description": "Script to run on up" },
              "down": { "type": "string", "description": "Script to run on down" },
              "stop": { "type": "string", "description": "Script to run on stop" }
            }
          },
          "docker": {
            "type": "object",
            "description": "Standalone Docker container plugin configuration",
            "additionalProperties": false,
            "properties": {
              "image": { "type": "string" },
              "name": { "type": "string" },
              "ports": { "type": "array", "items": { "type": "string" } },
              "volumes": { "type": "array", "items": { "type": "string" } },
              "env": { "type": "object", "additionalProperties": { "type": "string" } },
              "options": { "type": "array", "items": { "type": "string" } }
            }
          },
          "kubectl": {
            "type": "object",
            "description": "Kubectl apply plugin configuration",
            "additionalProperties": false,
            "properties": {
              "manifests": { "type": "array", "items": { "type": "string" } },
              "namespace": { "type": "string" },
              "context": { "type": "string" },
              "kubeconfig": { "type": "string", "description": "Path to kubeconfig file" }
            }
          },
          "helm": {
            "type": "object",
            "description": "Helm chart deployment plugin configuration",
            "additionalProperties": false,
            "properties": {
              "chart": { "type": "string" },
              "release": { "type": "string" },
              "namespace": { "type": "string" },
              "context": { "type": "string" },
              "values": { "type": "array", "items": { "type": "string" } },
              "set": { "type": "object", "additionalProperties": { "type": "string" } }
            }
          },
          "kustomize": {
            "type": "object",
            "description": "Kustomize overlay plugin configuration",
            "additionalProperties": false,
            "properties": {
              "dir": { "type": "string" },
              "namespace": { "type": "string" },
              "context": { "type": "string" }
            }
          },
          "tilt": {
            "type": "object",
            "description": "Tilt local dev plugin configuration",
            "additionalProperties": false,
            "properties": {
              "dir": { "type": "string" },
              "args": { "type": "array", "items": { "type": "string" } }
            }
          },
          "skaffold": {
            "type": "object",
            "description": "Skaffold pipeline plugin configuration",
            "additionalProperties": false,
            "properties": {
              "config": { "type": "string" },
              "profile": { "type": "string" },
              "args": { "type": "array", "items": { "type": "string" } }
            }
          },
          "podman_compose": {
            "type": "object",
            "description": "Podman Compose plugin configuration",
            "additionalProperties": false,
            "properties": {
              "files": { "type": "array", "items": { "type": "string" } },
              "project_name": { "type": "string" }
            }
          },
          "vagrant": {
            "type": "object",
            "description": "Vagrant VM plugin configuration",
            "additionalProperties": false,
            "properties": {
              "dir": { "type": "string" },
              "machine": { "type": "string" }
            }
          },
          "sam": {
            "type": "object",
            "description": "AWS SAM local plugin configuration",
            "additionalProperties": false,
            "properties": {
              "template": { "type": "string" },
              "port": { "type": "integer" },
              "args": { "type": "array", "items": { "type": "string" } }
            }
          },
          "serverless": {
            "type": "object",
            "description": "Serverless offline plugin configuration",
            "additionalProperties": false,
            "properties": {
              "dir": { "type": "string" },
              "port": { "type": "integer" },
              "args": { "type": "array", "items": { "type": "string" } }
            }
          },
          "multipass": {
            "type": "object",
            "description": "Multipass VM plugin configuration",
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "image": { "type": "string" },
              "cpus": { "type": "integer" },
              "memory": { "type": "string" },
              "disk": { "type": "string" },
              "cloud_init": { "type": "string" }
            }
          }
        }
      },
      "examples": [
        {
          "compose": {
            "order": 10,
            "files": ["compose.yml"],
            "project_name": "myapp"
          },
          "k8s": {
            "plugin": "kubectl",
            "order": 20,
            "namespace": "myapp-dev"
          }
        }
      ]
    },
    "lifecycle": {
      "type": "object",
      "description": "DEPRECATED: Use 'stack' instead. Alias for backward compatibility.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "interaction": {
      "type": "object",
      "description": "Defines the commands and their configurations",
      "patternProperties": {
        "^[\\w\\-.:/\\s]+$": {
          "$ref": "#/definitions/interaction_command"
        }
      },
      "additionalProperties": false
    },
    "provision": {
      "type": "object",
      "description": "Execute commands within provision section. Keys represent provision profiles (e.g., 'default', 'reset'), each containing an array of commands to execute. Use 'default_profile' to set the default profile name.",
      "properties": {
        "default_profile": {
          "type": "string",
          "description": "Name of the default provision profile to use when none is specified",
          "examples": ["setup", "default"]
        }
      },
      "examples": [
        {
          "default": [
            { "step": "Installing dependencies", "run": "bundle install" },
            { "step": "Setting up database", "run": ["rails db:create", "rails db:migrate"] },
            { "step": "Complete", "note": "Run 'rails server' to start" }
          ],
          "legacy_string": [
            "echo 'Setting up...'",
            "docker compose down --volumes",
            "sleep 2"
          ],
          "legacy_structured": [
            { "echo": "🚀 Starting..." },
            { "cmd": "docker compose up -d" },
            { "sleep": 10 }
          ]
        }
      ]
    },
    "environment": {
      "$ref": "#/definitions/environment_vars"
    },
    "env_file": {
      "$ref": "#/definitions/env_file"
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Paths to module configuration files",
      "examples": [["production"]]
    },
    "infra": {
      "type": "object",
      "description": "Contains infrastructure services configuration",
      "additionalProperties": false,
      "patternProperties": {
        "^[\\w\\-.:/\\s]+$": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "git": {
              "type": "string",
              "pattern": "^(git@|git://|https?://)[\\w\\d.@:/\\-]+$",
              "description": "Git repository URL for the infrastructure component",
              "examples": ["https://github.com/mycompany/redis-config.git"]
            },
            "ref": {
              "type": "string",
              "description": "Specifies the Git reference (branch, tag, or commit) to use",
              "examples": ["main"]
            },
            "path": {
              "type": "string",
              "description": "Local path to the infrastructure component",
              "examples": ["./infra/elasticsearch"]
            }
          },
          "oneOf": [
            { "required": ["git"] },
            { "required": ["path"] }
          ]
        }
      }
    },
    "subprojects": {
      "type": "object",
      "description": "Defines sub-projects that can be integrated when running DVA from a devbox (parent project)",
      "patternProperties": {
        "^[\\w\\-.]+$": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "description": "Relative or absolute path to the sub-project directory (must contain its own dva.yml)",
              "examples": ["cwrapper-engine-py", "../other-project"]
            },
            "exclude_tags": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Tags to exclude when integrating this sub-project from the parent devbox",
              "examples": [["infra"], ["infra", "monitoring"]]
            }
          },
          "required": ["path"]
        }
      },
      "additionalProperties": false
    },
    "devcontainer": {
      "type": "object",
      "description": "DevContainer configuration for VSCode integration",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable or disable devcontainer integration",
          "examples": [true]
        },
        "config_path": {
          "type": "string",
          "description": "Path to existing devcontainer.json file to sync with",
          "examples": [".devcontainer/devcontainer.json"]
        },
        "name": {
          "type": "string",
          "description": "Display name for the devcontainer",
          "examples": ["My Rails App Development"]
        },
        "image": {
          "type": "string",
          "description": "Docker image to use (alternative to dockerFile)",
          "examples": ["mcr.microsoft.com/devcontainers/ruby:3.2"]
        },
        "dockerFile": {
          "type": "string",
          "description": "Path to Dockerfile (alternative to image)",
          "examples": ["Dockerfile", ".devcontainer/Dockerfile"]
        },
        "service": {
          "type": "string",
          "description": "Docker Compose service to use",
          "examples": ["app", "web"]
        },
        "workspaceFolder": {
          "type": "string",
          "description": "Path to workspace folder inside container",
          "examples": ["/workspace", "/app"]
        },
        "remoteUser": {
          "type": "string",
          "description": "User to run as inside container",
          "examples": ["vscode", "node", "root"]
        },
        "features": {
          "type": "object",
          "description": "DevContainer features to install",
          "additionalProperties": {
            "type": "object"
          },
          "examples": [{
            "ghcr.io/devcontainers/features/docker-in-docker:2": {},
            "ghcr.io/devcontainers/features/github-cli:1": {"version": "latest"}
          }]
        },
        "customizations": {
          "type": "object",
          "description": "Tool-specific customizations (VSCode, etc.)",
          "additionalProperties": true,
          "examples": [{
            "vscode": {
              "extensions": ["rebornix.ruby", "castwide.solargraph"],
              "settings": {"ruby.rubocop.path": "/usr/local/bundle/bin/"}
            }
          }]
        },
        "forwardPorts": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "description": "Ports to forward from container to host",
          "examples": [[3000, 5432, 6379]]
        },
        "postCreateCommand": {
          "oneOf": [
            {"type": "string"},
            {"type": "array", "items": {"type": "string"}}
          ],
          "description": "Command to run after container is created",
          "examples": ["bundle install && rails db:setup"]
        },
        "postStartCommand": {
          "oneOf": [
            {"type": "string"},
            {"type": "array", "items": {"type": "string"}}
          ],
          "description": "Command to run each time container starts",
          "examples": ["rails server"]
        },
        "postAttachCommand": {
          "oneOf": [
            {"type": "string"},
            {"type": "array", "items": {"type": "string"}}
          ],
          "description": "Command to run after attaching to container",
          "examples": ["echo 'Welcome to development environment'"]
        },
        "mounts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Additional volume mounts",
          "examples": [["source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind"]]
        },
        "runArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Additional arguments for docker run",
          "examples": [["--cap-add=SYS_PTRACE", "--security-opt", "seccomp=unconfined"]]
        }
      }
    },
    "modes": {
      "type": "object",
      "description": "Named operational modes for dva up (--mode/-M flag). Each mode defines which compose profiles/services to start, health checks to run, and environment overrides.",
      "patternProperties": {
        "^[\\w\\-.]+$": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "description": {
              "type": "string",
              "description": "Human-readable description of this mode"
            },
            "compose_profiles": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Docker Compose profiles to activate (passed as --profile flags)",
              "examples": [["infra"], ["infra", "monitoring"]]
            },
            "compose_services": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Explicit list of compose services to start. Empty array = skip compose entirely (native mode). Omit = start all services.",
              "examples": [["postgres", "redis"], []]
            },
            "health_checks": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Health check names to activate (from health_checks section). Omit = use all.",
              "examples": [["app", "worker"]]
            },
            "endpoint_tags": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Show only endpoints matching these tags. Omit = show all endpoints.",
              "examples": [["app"], ["app", "monitoring"]]
            },
            "environment": {
              "$ref": "#/definitions/environment_vars"
            },
            "stack": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Stack entry names to include in this mode. Only these entries will be started.",
              "examples": [["compose", "kubectl"]]
            },
            "provision": {
              "type": "string",
              "description": "Provision profile to suggest when services start for the first time",
              "examples": ["setup", "reset"]
            }
          }
        }
      },
      "additionalProperties": false,
      "examples": [{
        "infra-only": {
          "description": "Infrastructure only",
          "compose_services": ["postgres", "redis"]
        },
        "hybrid": {
          "description": "Infra in containers, app locally",
          "compose_services": ["postgres", "redis"],
          "health_checks": ["app"],
          "endpoint_tags": ["app"],
          "environment": { "DATABASE_URL": "postgres://localhost:5432/mydb" }
        },
        "native": {
          "description": "Everything local, no Docker",
          "compose_services": [],
          "health_checks": ["postgres", "redis", "app"]
        }
      }]
    },
    "environments": {
      "type": "object",
      "description": "Named environment configurations for --env/-E flag. Each environment defines environment variable overrides.",
      "patternProperties": {
        "^[\\w\\-.]+$": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "description": {
              "type": "string",
              "description": "Human-readable description of this environment"
            },
            "environment": {
              "$ref": "#/definitions/environment_vars"
            }
          }
        }
      },
      "additionalProperties": false,
      "examples": [{
        "dev": {
          "description": "Development settings",
          "environment": { "LOG_LEVEL": "debug", "ENABLE_HOT_RELOAD": "true" }
        },
        "test": {
          "description": "Test settings",
          "environment": { "DATABASE_URL": "postgres://localhost:5432/mydb_test" }
        }
      }]
    },
    "ssh": {
      "type": "object",
      "description": "SSH agent configuration",
      "additionalProperties": false,
      "properties": {
        "agent_image": {
          "type": "string",
          "description": "Docker image for the SSH agent container (default: whilp/ssh-agent)",
          "examples": ["whilp/ssh-agent", "my-registry/ssh-agent:latest"]
        }
      }
    },
    "endpoints": {
      "type": "object",
      "description": "Declares user-facing endpoint URLs for the project. Compose service ports are shown automatically; use this for non-compose endpoints (local processes, external services). Keys matching health_check names are auto-linked for status display.",
      "patternProperties": {
        "^[\\w\\-.]+$": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "url": {
              "type": "string",
              "description": "User-facing access URL",
              "examples": ["http://localhost:8080", "ssh://git@localhost:2222", "grpc://localhost:50051"]
            },
            "label": {
              "type": "string",
              "description": "Human-readable display name",
              "examples": ["API Server", "Git SSH", "Admin Panel"]
            },
            "tags": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Tags for filtering (used by modes.endpoint_tags)",
              "examples": [["app"], ["infra", "monitoring"]]
            },
            "paths": {
              "type": "object",
              "description": "Sub-paths with descriptions (key: path, value: description)",
              "additionalProperties": { "type": "string" },
              "examples": [{ "/api/v1": "REST API", "/metrics": "Prometheus metrics" }]
            }
          },
          "required": ["url", "label"]
        }
      },
      "additionalProperties": false,
      "examples": [{
        "app-http": {
          "url": "http://localhost:8080",
          "label": "App HTTP",
          "tags": ["app"],
          "paths": { "/health": "Health check", "/api/v1": "REST API" }
        },
        "app-ssh": {
          "url": "ssh://git@localhost:2222",
          "label": "Git SSH",
          "tags": ["app"]
        }
      }]
    },
    "health_checks": {
      "type": "object",
      "description": "Health checks for non-compose services (e.g., local processes, external dependencies)",
      "patternProperties": {
        "^[\\w\\-.]+$": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "enum": ["http", "tcp", "command"],
              "description": "Health check type"
            },
            "url": {
              "type": "string",
              "description": "URL for http type health check",
              "examples": ["http://localhost:8080/health"]
            },
            "address": {
              "type": "string",
              "description": "Host:port for tcp type health check",
              "examples": ["localhost:5432"]
            },
            "command": {
              "type": "string",
              "description": "Shell command for command type health check",
              "examples": ["pg_isready -U dev"]
            },
            "start": {
              "type": "string",
              "description": "Shell command to auto-start this service in the background",
              "examples": ["redis-server --daemonize yes", "postgres -D /usr/local/var/postgresql@14"]
            },
            "start_hint": {
              "type": "string",
              "description": "Human-readable hint shown when service is not ready (no auto-start)",
              "examples": ["brew services start postgresql"]
            },
            "timeout": {
              "type": "integer",
              "description": "Timeout in seconds (default: 2)",
              "default": 2,
              "examples": [5]
            },
            "ready_timeout": {
              "type": "integer",
              "description": "Maximum time in seconds to wait for a service to become ready after auto-start (default: 30)",
              "default": 30,
              "examples": [60]
            }
          },
          "required": ["type"]
        }
      },
      "additionalProperties": false
    },
    "checks": {
      "type": "array",
      "description": "Environment checks for 'dva doctor'. Validates prerequisites before running services.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "description": "Human-readable name of the check",
            "examples": ["Docker socket accessible"]
          },
          "type": {
            "type": "string",
            "enum": ["file_exists", "command", "docker_socket"],
            "description": "Type of check to perform"
          },
          "path": {
            "type": "string",
            "description": "File path to check (for file_exists type)",
            "examples": [".env", "docker-compose.yml"]
          },
          "command": {
            "type": "string",
            "description": "Shell command to run (for command type, exit 0 = pass)",
            "examples": ["docker info > /dev/null 2>&1"]
          },
          "fix_hint": {
            "type": "string",
            "description": "Suggestion shown when the check fails",
            "examples": ["cp .env.example .env", "dva provision setup"]
          }
        },
        "required": ["name", "type"]
      },
      "examples": [
        [
          { "name": "Docker socket accessible", "type": "docker_socket", "fix_hint": "Start Docker Desktop" },
          { "name": ".env file exists", "type": "file_exists", "path": ".env", "fix_hint": "cp .env.example .env" },
          { "name": "DB migrations applied", "type": "command", "command": "make migrate-status 2>&1 | grep -qv pending", "fix_hint": "dva provision setup" }
        ]
      ]
    }
  },
  "required": ["version"]
}

{
  "$schema": "http://json-schema.org/draft-06/schema#",
  "title": "DVA Configuration Schema",
  "description": "Schema for the dva.yml configuration file",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "environment_vars": {
      "type": "object",
      "description": "Defines environment variables",
      "additionalProperties": {
        "type": ["string", "boolean", "number"]
      },
      "examples": [
        { "RAILS_ENV": "development" },
        { "DATABASE_URL": "postgres://user:password@db:5432/myapp_development" },
        { "PORT": "${PORT:-3000}" }
      ]
    },
    "env_file": {
      "oneOf": [
        {
          "type": "string",
          "description": "Path to a single .env file"
        },
        {
          "type": "array",
          "items": {
            "oneOf": [
              { "type": "string" },
              {
                "type": "object",
                "properties": {
                  "path": { "type": "string" },
                  "required": { "type": "boolean", "default": false }
                },
                "required": ["path"],
                "additionalProperties": false
              }
            ]
          },
          "description": "Array of .env file paths (later files override earlier)"
        },
        {
          "type": "object",
          "properties": {
            "files": {
              "oneOf": [
                { "type": "string" },
                {
                  "type": "array",
                  "items": {
                    "oneOf": [
                      { "type": "string" },
                      {
                        "type": "object",
                        "properties": {
                          "path": { "type": "string" },
                          "required": { "type": "boolean", "default": false }
                        },
                        "required": ["path"],
                        "additionalProperties": false
                      }
                    ]
                  }
                }
              ]
            },
            "priority": {
              "type": "string",
              "enum": ["before_environment", "after_environment"],
              "default": "before_environment",
              "description": "Control whether env_file or environment: takes precedence"
            },
            "required": {
              "type": "boolean",
              "default": false,
              "description": "Whether env files are required to exist"
            },
            "interpolate": {
              "type": "boolean",
              "default": true,
              "description": "Enable variable interpolation in .env files"
            }
          },
          "required": ["files"],
          "additionalProperties": false
        }
      ],
      "examples": [
        ".env",
        [".env.defaults", ".env", ".env.local"],
        {
          "files": [".env.defaults", ".env"],
          "priority": "before_environment",
          "required": false
        }
      ]
    },
    "interaction_command": {
      "type": "object",
      "description": "Configuration for an interaction command",
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string",
          "description": "Describes the command",
          "examples": ["Run Rails commands", "Connect to PostgreSQL database"]
        },
        "service": {
          "type": "string",
          "description": "Specifies the service associated with the command",
          "examples": ["web", "frontend", "db"]
        },
        "command": {
          "type": "string",
          "description": "Represents the command to be executed",
          "examples": ["bundle exec rails", "npm", "psql -h db -U user myapp_development"]
        },
        "workdir": {
          "type": "string",
          "description": "Specifies the working directory for the command",
          "examples": ["/workdir", "/app"]
        },
        "user": {
          "type": "string",
          "description": "Specifies the user to run the command as",
          "examples": ["root:root", "root", "www-data", "1000:1000"]
        },
        "default_args": {
          "type": "string",
          "description": "Default arguments for the command",
          "examples": ["server -p 3000 -b 0.0.0.0"]
        },
        "environment": {
          "$ref": "#/definitions/environment_vars"
        },
        "env_file": {
          "$ref": "#/definitions/env_file"
        },
        "compose": {
          "type": "object",
          "description": "Allows specifying Docker Compose options",
          "additionalProperties": false,
          "properties": {
            "method": {
              "type": "string",
              "description": "Specifies the Docker Compose method (e.g., up, run)",
              "examples": ["run", "up", "exec"]
            },
            "compose_method": {
              "type": "string",
              "description": "Specifies an alternative Docker Compose method to use in compose commands",
              "examples": ["up"]
            },
            "run_options": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Options to pass to the 'docker-compose run' command",
              "examples": [["service-ports", "rm"]]
            },
            "profiles": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Docker Compose profiles to use",
              "examples": [["web", "development"], ["frontend"], ["test"]]
            }
          }
        },
        "shell": {
          "type": "boolean",
          "description": "Enables or disables shell interpolation"
        },
        "entrypoint": {
          "type": "string",
          "description": "Specifies the command entrypoint"
        },
        "runner": {
          "type": "string",
          "description": "Specifies the runner (e.g., docker_compose, kubectl)"
        },
        "pod": {
          "type": "string",
          "description": "Specifies the pod for the kubectl runner"
        },
        "compose_run_options": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "DEPRECATED: Options to pass to the 'docker-compose run' command",
          "examples": [["service-ports", "rm"]]
        },
        "subcommands": {
          "type": "object",
          "description": "Contains subcommands with the same structure as main commands",
          "patternProperties": {
            "^[\\w\\-.:/\\s]+$": {
              "$ref": "#/definitions/interaction_command"
            }
          },
          "minProperties": 1,
          "additionalProperties": false
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Tags for categorizing this command (e.g., test, quality, infra)",
          "examples": [["test"], ["quality"], ["infra", "db"]]
        }
      }
    }
  },
  "properties": {
    "version": {
      "type": "string",
      "description": "Specifies the minimum required version of DVA",
      "examples": ["8.1.0"]
    },
    "compose": {
      "type": "object",
      "description": "Contains Docker Compose configuration",
      "properties": {
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Array of strings representing paths to Docker Compose files",
          "examples": [["docker-compose.yml", "docker-compose.override.yml"]]
        },
        "project_name": {
          "type": "string",
          "description": "Specifies the project name for Docker Compose",
          "examples": ["app"]
        },
        "command": {
          "type": "string",
          "description": "Specifies an alternative Docker Compose command",
          "examples": ["docker compose"]
        },
        "method": {
          "type": "string",
          "description": "Specifies the Docker Compose method to use"
        },
        "up_options": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Default options for 'dva up' command",
          "examples": [["-d", "--wait"], ["--build", "-d"]]
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Default tags for all compose services (e.g., infra, app)",
          "examples": [["infra"], ["app"]]
        },
        "services": {
          "type": "object",
          "description": "Per-service tag configuration to override compose-level defaults",
          "patternProperties": {
            "^[\\w\\-.]+$": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "tags": {
                  "type": "array",
                  "items": { "type": "string" },
                  "description": "Tags for this specific service"
                },
                "ports": {
                  "type": "object",
                  "description": "Per-port labels and sub-path descriptions (key is published host port)",
                  "patternProperties": {
                    "^[0-9]+$": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "label": {
                          "type": "string",
                          "description": "Human-readable label for this port"
                        },
                        "http": {
                          "type": "boolean",
                          "description": "Force http:// prefix (true) or plain host:port (false). Omit to auto-detect from well-known ports."
                        },
                        "paths": {
                          "type": "object",
                          "description": "Sub-paths with descriptions (key: path, value: description)",
                          "additionalProperties": { "type": "string" }
                        }
                      }
                    }
                  },
                  "additionalProperties": false
                },
                "related": {
                  "type": "array",
                  "items": { "type": "string" },
                  "description": "Related service names that should typically run alongside this service",
                  "examples": [["worker", "scheduler"]]
                },
                "hint": {
                  "type": "string",
                  "description": "Human-readable hint shown when related services are not running",
                  "examples": ["Worker is required for async job processing"]
                }
              }
            }
          },
          "additionalProperties": false
        }
      }
    },
    "interaction": {
      "type": "object",
      "description": "Defines the commands and their configurations",
      "patternProperties": {
        "^[\\w\\-.:/\\s]+$": {
          "$ref": "#/definitions/interaction_command"
        }
      },
      "additionalProperties": false
    },
    "provision": {
      "type": "object",
      "description": "Execute commands within provision section. Keys represent provision profiles (e.g., 'default', 'reset'), each containing an array of commands to execute. Commands can be strings (shell commands), step objects (structured steps with run/note), or legacy structured commands.",
      "patternProperties": {
        "^[\\w\\-.:/\\s]+$": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string",
                "description": "Raw shell command string"
              },
              {
                "type": "object",
                "description": "Step-based command with name, run commands, and optional notes",
                "additionalProperties": false,
                "properties": {
                  "step": {
                    "type": "string",
                    "description": "Name of the step (displayed with progress indicator)"
                  },
                  "run": {
                    "oneOf": [
                      { "type": "string" },
                      { "type": "array", "items": { "type": "string" } }
                    ],
                    "description": "Command(s) to execute for this step"
                  },
                  "note": {
                    "type": "string",
                    "description": "Informational note displayed before/after commands (supports multiline)"
                  },
                  "compose_up": {
                    "type": "array",
                    "items": { "type": "string" },
                    "description": "Docker Compose services to start (inherits compose.files and compose.project_name)",
                    "examples": [["postgres", "minio", "redis"]]
                  },
                  "compose_exec": {
                    "type": "string",
                    "description": "Command to execute in a compose service (inherits compose config)",
                    "examples": ["postgres pg_isready -U ndstack"]
                  },
                  "compose_run": {
                    "type": "string",
                    "description": "One-off command in a compose service (inherits compose config)",
                    "examples": ["migrate python manage.py migrate"]
                  }
                },
                "required": ["step"]
              },
              {
                "type": "object",
                "description": "Legacy structured command with explicit type and arguments",
                "additionalProperties": false,
                "properties": {
                  "echo": {
                    "type": "string",
                    "description": "Execute echo command with the given text"
                  },
                  "cmd": {
                    "type": "string",
                    "description": "Execute a raw shell command"
                  },
                  "shell": {
                    "type": "string",
                    "description": "Execute a multi-line shell script"
                  },
                  "sleep": {
                    "oneOf": [
                      { "type": "integer" },
                      { "type": "number" },
                      { "type": "string" }
                    ],
                    "description": "Sleep for the specified number of seconds"
                  },
                  "docker": {
                    "type": "object",
                    "description": "Execute docker command",
                    "additionalProperties": false,
                    "properties": {
                      "compose": {
                        "oneOf": [
                          {
                            "type": "string",
                            "description": "Docker compose command with arguments"
                          },
                          {
                            "type": "array",
                            "items": { "type": "string" },
                            "description": "Docker compose command as array of arguments"
                          }
                        ]
                      }
                    },
                    "required": ["compose"]
                  }
                },
                "minProperties": 1,
                "maxProperties": 1
              }
            ]
          },
          "description": "Array of commands (strings, step objects, or legacy structured objects) to execute for this provision profile"
        }
      },
      "additionalProperties": false,
      "examples": [
        {
          "default": [
            { "step": "Installing dependencies", "run": "bundle install" },
            { "step": "Setting up database", "run": ["rails db:create", "rails db:migrate"] },
            { "step": "Complete", "note": "Run 'rails server' to start" }
          ],
          "legacy_string": [
            "echo 'Setting up...'",
            "docker compose down --volumes",
            "sleep 2"
          ],
          "legacy_structured": [
            { "echo": "🚀 Starting..." },
            { "cmd": "docker compose up -d" },
            { "sleep": 10 }
          ]
        }
      ]
    },
    "environment": {
      "$ref": "#/definitions/environment_vars"
    },
    "env_file": {
      "$ref": "#/definitions/env_file"
    },
    "kubectl": {
      "type": "object",
      "description": "Contains Kubernetes configuration",
      "additionalProperties": false,
      "properties": {
        "namespace": {
          "type": "string",
          "description": "Specifies the Kubernetes namespace to use",
          "examples": ["app"]
        }
      }
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Paths to module configuration files",
      "examples": [["production"]]
    },
    "infra": {
      "type": "object",
      "description": "Contains infrastructure services configuration",
      "additionalProperties": false,
      "patternProperties": {
        "^[\\w\\-.:/\\s]+$": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "git": {
              "type": "string",
              "pattern": "^(git@|git://|https?://)[\\w\\d.@:/\\-]+$",
              "description": "Git repository URL for the infrastructure component",
              "examples": ["https://github.com/mycompany/redis-config.git"]
            },
            "ref": {
              "type": "string",
              "description": "Specifies the Git reference (branch, tag, or commit) to use",
              "examples": ["main"]
            },
            "path": {
              "type": "string",
              "description": "Local path to the infrastructure component",
              "examples": ["./infra/elasticsearch"]
            }
          },
          "oneOf": [
            { "required": ["git"] },
            { "required": ["path"] }
          ]
        }
      }
    },
    "subprojects": {
      "type": "object",
      "description": "Defines sub-projects that can be integrated when running DVA from a devbox (parent project)",
      "patternProperties": {
        "^[\\w\\-.]+$": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "description": "Relative or absolute path to the sub-project directory (must contain its own dva.yml)",
              "examples": ["cwrapper-engine-py", "../other-project"]
            },
            "exclude_tags": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Tags to exclude when integrating this sub-project from the parent devbox",
              "examples": [["infra"], ["infra", "monitoring"]]
            }
          },
          "required": ["path"]
        }
      },
      "additionalProperties": false
    },
    "devcontainer": {
      "type": "object",
      "description": "DevContainer configuration for VSCode integration",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable or disable devcontainer integration",
          "examples": [true]
        },
        "config_path": {
          "type": "string",
          "description": "Path to existing devcontainer.json file to sync with",
          "examples": [".devcontainer/devcontainer.json"]
        },
        "name": {
          "type": "string",
          "description": "Display name for the devcontainer",
          "examples": ["My Rails App Development"]
        },
        "image": {
          "type": "string",
          "description": "Docker image to use (alternative to dockerFile)",
          "examples": ["mcr.microsoft.com/devcontainers/ruby:3.2"]
        },
        "dockerFile": {
          "type": "string",
          "description": "Path to Dockerfile (alternative to image)",
          "examples": ["Dockerfile", ".devcontainer/Dockerfile"]
        },
        "service": {
          "type": "string",
          "description": "Docker Compose service to use",
          "examples": ["app", "web"]
        },
        "workspaceFolder": {
          "type": "string",
          "description": "Path to workspace folder inside container",
          "examples": ["/workspace", "/app"]
        },
        "remoteUser": {
          "type": "string",
          "description": "User to run as inside container",
          "examples": ["vscode", "node", "root"]
        },
        "features": {
          "type": "object",
          "description": "DevContainer features to install",
          "additionalProperties": {
            "type": "object"
          },
          "examples": [{
            "ghcr.io/devcontainers/features/docker-in-docker:2": {},
            "ghcr.io/devcontainers/features/github-cli:1": {"version": "latest"}
          }]
        },
        "customizations": {
          "type": "object",
          "description": "Tool-specific customizations (VSCode, etc.)",
          "additionalProperties": true,
          "examples": [{
            "vscode": {
              "extensions": ["rebornix.ruby", "castwide.solargraph"],
              "settings": {"ruby.rubocop.path": "/usr/local/bundle/bin/"}
            }
          }]
        },
        "forwardPorts": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "description": "Ports to forward from container to host",
          "examples": [[3000, 5432, 6379]]
        },
        "postCreateCommand": {
          "oneOf": [
            {"type": "string"},
            {"type": "array", "items": {"type": "string"}}
          ],
          "description": "Command to run after container is created",
          "examples": ["bundle install && rails db:setup"]
        },
        "postStartCommand": {
          "oneOf": [
            {"type": "string"},
            {"type": "array", "items": {"type": "string"}}
          ],
          "description": "Command to run each time container starts",
          "examples": ["rails server"]
        },
        "postAttachCommand": {
          "oneOf": [
            {"type": "string"},
            {"type": "array", "items": {"type": "string"}}
          ],
          "description": "Command to run after attaching to container",
          "examples": ["echo 'Welcome to development environment'"]
        },
        "mounts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Additional volume mounts",
          "examples": [["source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind"]]
        },
        "runArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Additional arguments for docker run",
          "examples": [["--cap-add=SYS_PTRACE", "--security-opt", "seccomp=unconfined"]]
        }
      }
    },
    "profiles": {
      "type": "object",
      "description": "Named operational modes for dva up. Each profile defines which compose profiles/services to start, health checks to run, and environment overrides.",
      "patternProperties": {
        "^[\\w\\-.]+$": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "description": {
              "type": "string",
              "description": "Human-readable description of this mode"
            },
            "compose_profiles": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Docker Compose profiles to activate (passed as --profile flags)",
              "examples": [["infra"], ["infra", "monitoring"]]
            },
            "compose_services": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Explicit list of compose services to start. Empty array = skip compose entirely (native mode). Omit = start all services.",
              "examples": [["postgres", "redis"], []]
            },
            "health_checks": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Health check names to activate (from health_checks section). Omit = use all.",
              "examples": [["app", "worker"]]
            },
            "environment": {
              "$ref": "#/definitions/environment_vars"
            },
            "provision": {
              "type": "string",
              "description": "Provision profile to suggest when services start for the first time",
              "examples": ["setup", "reset"]
            }
          }
        }
      },
      "additionalProperties": false,
      "examples": [{
        "docker": {
          "description": "All services in containers"
        },
        "dev": {
          "description": "Infra in containers, app locally",
          "compose_profiles": ["infra"],
          "health_checks": ["app"],
          "environment": { "DATABASE_URL": "postgres://localhost:5432/mydb" }
        },
        "native": {
          "description": "Everything local",
          "compose_services": [],
          "health_checks": ["postgres", "redis", "app"]
        }
      }]
    },
    "ssh": {
      "type": "object",
      "description": "SSH agent configuration",
      "additionalProperties": false,
      "properties": {
        "agent_image": {
          "type": "string",
          "description": "Docker image for the SSH agent container (default: whilp/ssh-agent)",
          "examples": ["whilp/ssh-agent", "my-registry/ssh-agent:latest"]
        }
      }
    },
    "health_checks": {
      "type": "object",
      "description": "Health checks for non-compose services (e.g., local processes, external dependencies)",
      "patternProperties": {
        "^[\\w\\-.]+$": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "enum": ["http", "tcp", "command"],
              "description": "Health check type"
            },
            "url": {
              "type": "string",
              "description": "URL for http type health check",
              "examples": ["http://localhost:8080/health"]
            },
            "address": {
              "type": "string",
              "description": "Host:port for tcp type health check",
              "examples": ["localhost:5432"]
            },
            "command": {
              "type": "string",
              "description": "Shell command for command type health check",
              "examples": ["pg_isready -U dev"]
            },
            "start": {
              "type": "string",
              "description": "Shell command to auto-start this service in the background",
              "examples": ["redis-server --daemonize yes", "postgres -D /usr/local/var/postgresql@14"]
            },
            "start_hint": {
              "type": "string",
              "description": "Human-readable hint shown when service is not ready (no auto-start)",
              "examples": ["brew services start postgresql"]
            },
            "timeout": {
              "type": "integer",
              "description": "Timeout in seconds (default: 2)",
              "default": 2,
              "examples": [5]
            },
            "ready_timeout": {
              "type": "integer",
              "description": "Maximum time in seconds to wait for a service to become ready after auto-start (default: 30)",
              "default": 30,
              "examples": [60]
            }
          },
          "required": ["type"]
        }
      },
      "additionalProperties": false
    },
    "checks": {
      "type": "array",
      "description": "Environment checks for 'dva doctor'. Validates prerequisites before running services.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "description": "Human-readable name of the check",
            "examples": ["Docker socket accessible"]
          },
          "type": {
            "type": "string",
            "enum": ["file_exists", "command", "docker_socket"],
            "description": "Type of check to perform"
          },
          "path": {
            "type": "string",
            "description": "File path to check (for file_exists type)",
            "examples": [".env", "docker-compose.yml"]
          },
          "command": {
            "type": "string",
            "description": "Shell command to run (for command type, exit 0 = pass)",
            "examples": ["docker info > /dev/null 2>&1"]
          },
          "fix_hint": {
            "type": "string",
            "description": "Suggestion shown when the check fails",
            "examples": ["cp .env.example .env", "dva provision setup"]
          }
        },
        "required": ["name", "type"]
      },
      "examples": [
        [
          { "name": "Docker socket accessible", "type": "docker_socket", "fix_hint": "Start Docker Desktop" },
          { "name": ".env file exists", "type": "file_exists", "path": ".env", "fix_hint": "cp .env.example .env" },

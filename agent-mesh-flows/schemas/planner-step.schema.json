{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agent-mesh.dev/schemas/planner-step-1.json",
  "title": "Agent Mesh Planner Step Schema",
  "description": "Step JSON generated by Planner based on Flow DSL",
  "type": "object",
  "required": ["step_id", "tool", "intent", "input", "schema_version"],
  "properties": {
    "step_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*(?:\\[[0-9]+\\])?(?:#[a-z0-9-]+)?(?:-retry[0-9]+)?$",
      "description": "Step identifier (from Flow or Planner-generated)"
    },
    "tool": {
      "type": "string",
      "enum": ["codex", "claude", "git", "shell", "docker", "ollama", "kubernetes", "helm", "argocd", "github", "jira", "gitlab", "mcp"],
      "description": "Connector tool to use"
    },
    "intent": {
      "type": "string",
      "enum": [
        "refactor", "analyze", "test", "edit", "commit", "diff", "status", "deploy",
        "branch_create", "branch_switch", "switch_repo", "clone_repo", "sync_repos", "cross_repo_diff",
        "merge", "branch_delete", "stash", "stash_pop",
        "build", "run", "exec",
        "apply", "get", "describe", "logs", "port_forward", "delete", "rollout", "scale",
        "install", "upgrade", "uninstall", "list", "rollback", "template",
        "sync", "refresh", "wait", "create",
        "trigger", "cancel",
        "call_tool", "list_tools", "list_resources", "read_resource", "list_prompts", "get_prompt",
        "search", "comment", "transition"
      ],
      "description": "Purpose of the Step"
    },
    "input": {
      "type": "object",
      "description": "Tool-specific input parameters",
      "additionalProperties": true
    },
    "repo": {
      "type": "string",
      "description": "Repository alias/name for this step"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "flow_defined": {
          "type": "boolean",
          "description": "true if from Flow DSL, false if Planner-generated"
        },
        "source_step_id": {
          "type": "string",
          "description": "Original Flow Step ID if modified"
        },
        "generation_reason": {
          "type": "string",
          "description": "Why Planner generated this Step (for flow_defined=false)"
        }
      },
      "additionalProperties": true
    },
    "schema_version": {
      "type": "string",
      "const": "planner-step-1",
      "description": "Schema version identifier"
    }
  },
  "additionalProperties": false
}

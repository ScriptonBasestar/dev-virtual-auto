{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agent-mesh.dev/schemas/event-1.json",
  "title": "Agent Mesh Event Schema",
  "description": "Event represents an entry in the Run/Step timeline (policy, context, quality, metrics, etc.)",
  "type": "object",
  "required": ["event_id", "run_id", "timestamp", "event_type", "severity", "message", "metadata", "schema_version"],
  "properties": {
    "event_id": {
      "type": "string",
      "description": "Unique event ID (e.g., event-<timestamp>-<seq>)"
    },
    "run_id": {
      "type": "string",
      "pattern": "^run-[0-9]{8}-[0-9]{3}$",
      "description": "Associated Run ID"
    },
    "step_id": {
      "type": ["string", "null"],
      "pattern": "^[a-z0-9][a-z0-9-]*(?:\\[[0-9]+\\])?(?:#[a-z0-9-]+)?(?:-retry[0-9]+)?$",
      "description": "Associated Step ID (optional)"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "Event timestamp"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "policy_violation",
        "policy_decision",
        "command_blocked",
        "command_warning",
        "context_profile_applied",
        "context_boundary_suggested",
        "quality_gate",
        "retry",
        "metric",
        "execution_warning",
        "workspace_setup",
        "workspace_cleanup"
      ],
      "description": "Type of event"
    },
    "severity": {
      "type": "string",
      "enum": ["debug", "info", "warning", "error", "critical"],
      "description": "Severity level"
    },
    "message": {
      "type": "string",
      "description": "Human-readable description"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "description": "Additional metadata"
    },
    "schema_version": {
      "type": "string",
      "const": "event-1",
      "description": "Schema version identifier"
    }
  },
  "additionalProperties": false
}

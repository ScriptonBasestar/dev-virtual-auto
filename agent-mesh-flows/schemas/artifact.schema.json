{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agent-mesh.dev/schemas/artifact-1.json",
  "title": "Agent Mesh Artifact Schema",
  "description": "Artifact represents an output generated by a Step (diff, patch, log, etc.)",
  "type": "object",
  "required": ["artifact_id", "step_id", "run_id", "type", "path", "created_at", "schema_version"],
  "properties": {
    "artifact_id": {
      "type": "string",
      "pattern": "^artifact-[0-9]{8}-[a-z0-9_]+$",
      "description": "Unique identifier for the Artifact"
    },
    "step_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*(?:\\[[0-9]+\\])?(?:#[a-z0-9-]+)?(?:-retry[0-9]+)?$",
      "description": "Parent Step ID"
    },
    "run_id": {
      "type": "string",
      "pattern": "^run-[0-9]{8}-[0-9]{3}$",
      "description": "Parent Run ID"
    },
    "type": {
      "type": "string",
      "enum": ["diff", "file", "json", "log", "metrics", "model_output"],
      "description": "Type of artifact content"
    },
    "path": {
      "type": "string",
      "description": "Relative path to artifact file in store"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when artifact was created"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "size": {
          "type": "integer",
          "minimum": 0,
          "description": "File size in bytes"
        },
        "format": {
          "type": "string",
          "description": "Content format (e.g., unified-diff, json, plain-text)"
        },
        "checksum": {
          "type": "string",
          "description": "SHA-256 checksum of content"
        }
      },
      "additionalProperties": true
    },
    "schema_version": {
      "type": "string",
      "const": "artifact-1",
      "description": "Schema version identifier"
    }
  },
  "additionalProperties": false
}

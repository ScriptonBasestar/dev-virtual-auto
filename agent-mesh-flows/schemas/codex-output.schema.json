{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agent-mesh.dev/schemas/codex-output-1.json",
  "title": "Agent Mesh Codex Connector Output Schema",
  "description": "Extended output schema for CodexConnector with LLM-specific fields",
  "allOf": [
    {
      "$ref": "connector-output.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "meta": {
          "type": "object",
          "properties": {
            "tool": {
              "const": "codex"
            },
            "raw": {
              "type": "object",
              "properties": {
                "files_changed": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Number of files modified"
                },
                "patches": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "List of generated patch file paths"
                },
                "summary": {
                  "type": "string",
                  "description": "LLM-generated summary of changes"
                },
                "parse_error": {
                  "type": "boolean",
                  "default": false,
                  "description": "JSON parsing failed flag"
                },
                "model": {
                  "type": "string",
                  "description": "Model used (e.g., gpt-4)"
                },
                "tokens_used": {
                  "type": "object",
                  "properties": {
                    "prompt": {
                      "type": "integer"
                    },
                    "completion": {
                      "type": "integer"
                    },
                    "total": {
                      "type": "integer"
                    }
                  }
                }
              },
              "additionalProperties": true
            }
          }
        }
      }
    }
  ]
}
